# Copy to .env and fill in local values. Never commit .env.
# Every variable the system reads is listed here, with placeholder values only.

# --- App ---
APP_ENV=development
APP_SECRET_KEY=replace_me_with_a_long_random_string
# Fernet key for encrypting OAuth tokens at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace_me
DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0

# --- Models (see agent/config.yaml for the per-node routing) ---
# open | local | paid | test
MODEL_PROFILE=open
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Optional paid profile only
OPENAI_API_KEY=
# SQLite file for the LLM response cache (makes evals reproducible and cheap)
LLM_CACHE_PATH=.cache/llm_cache.sqlite
LLM_CACHE_ENABLED=true

# --- Marketplace ---
# gigsim | upwork
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
# Freelancer API tokens GigSim accepts, as token:account_id pairs separated by commas
GIGSIM_API_TOKENS=dev-token-ai:persona_ai_ml,dev-token-web:persona_fullstack,dev-token-data:persona_data_analyst
# Token for the selected synthetic persona in scripts/bid_demo.py
GIGBID_SIM_TOKEN=
# Saved web approvals for the local synthetic marketplace
GIGBID_WEB_CHECKPOINT=.cache/gigbid-web.sqlite
# Set local only for isolated GigSim accounts. The local launcher supplies these with --auth.
GIGBID_AUTH_MODE=demo
GIGBID_AUTH_DB=.cache/gigbid-auth.sqlite
GIGBID_AUTH_WEB_ORIGIN=http://127.0.0.1:3011
# Optional bare-metal queue and PostgreSQL checkpoint settings. Compose supplies these itself.
GIGBID_CHECKPOINT_DSN=
GIGBID_QUEUE_URL=
GIGBID_SCOUT_ENABLED=false
GIGSIM_ADMIN_TOKEN=replace_me_admin
GIGSIM_DB_URL=sqlite:///./.cache/gigsim.db
GIGSIM_WORLD_PATH=data/processed/gigsim_world
GIGSIM_SEED=4016
# rules | llm   (llm uses the model profile's "gigsim_client" node)
GIGSIM_CLIENT_MODE=rules

# --- Upwork live mode (OAuth 2.1, dynamic client registration) ---
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_OAUTH_REDIRECT_URI=http://localhost:8000/auth/upwork/callback

# --- MCP servers (bearer tokens on their HTTP endpoints) ---
MCP_PORTFOLIO_TOKEN=replace_me
MCP_MARKETPLACE_TOKEN=replace_me
MCP_WORKSPACE_TOKEN=replace_me
GITHUB_PAT=

# --- Tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid-dev

# --- Data ---
# Held-out test split (stand-in for the hidden set). Keep it OUTSIDE the repo.
GIGBID_TEST_SPLIT_PATH=../gigbid-private/test_split.jsonl
